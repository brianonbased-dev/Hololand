// HoloShell Native Wrapper
//
// Source contract for the first OS-local wrapper that starts the Founder
// HoloShell surface without manually opening the prototype HTML. This is a
// wrapper contract, not boot-time shell replacement.

composition "HoloShell Native Wrapper" {
  config {
    owner: "HoloLand"
    sourceLayer: "HoloScript"
    adapterScript: "scripts/holoshell-native-wrapper.mjs"
    upstreamCapabilityEnvelopeSource: "HoloScript:experiments/holoshell-human-os-frontier/native-holoshell-capability-envelope.hsplus"
    upstreamCapabilityEnvelopeSchema: "holoscript.holoshell.native-capability-envelope.v0.1.0"
    upstreamTerminalEventStreamSource: "HoloScript:experiments/holoshell-human-os-frontier/native-terminal-event-stream.hsplus"
    upstreamTerminalEventStreamSchema: "holoscript.holoshell.native-terminal-event-stream.v0.1.0"
    upstreamVisualOperatingLayerSource: "HoloScript:experiments/holoshell-human-os-frontier/native-visual-operating-layer.hsplus"
    upstreamVisualOperatingLayerSchema: "holoscript.holoshell.native-visual-operating-layer.v0.1.0"
    visualOperatingLayerSource: "apps/holoshell/source/holoshell-visual-operating-layer.hsplus"
    visualOperatingLayerEndpoint: "GET /api/visual-operating-layer"
    nativeCapabilityLanes: ["receipt_read", "terminal_event_read", "jetson_appliance_observe", "service_status", "guarded_service_ensure", "guarded_open_url", "break_glass_os_mutation"]
    startupIntegrationSource: "apps/holoshell/source/holoshell-startup-integration.hsplus"
    startupIntegrationAdapter: "scripts/holoshell-startup-integration.mjs"
    startupIntegrationReceipt: ".tmp/holoshell/startup-integration.json"
    wrapperReceipt: ".tmp/holoshell/native-wrapper.json"
    wrapperBootstrap: ".tmp/holoshell/native-wrapper.js"
    launcherRoot: "apps/holoshell/native"
    windowsLauncher: "apps/holoshell/native/windows/Start-HoloShellFounderHost.ps1"
    windowsCommandShim: "apps/holoshell/native/windows/Start-HoloShellFounderHost.cmd"
    windowsStartupRegistration: "apps/holoshell/native/windows/Register-HoloShellStartup.ps1"
    nativeAppSurfaceUrl: "http://holojetson.local:8747"
    browserSelfTestSurface: "GET /"
    serviceSupervisorSource: "apps/holoshell/source/holoshell-service-supervisor.hsplus"
    serviceSupervisorAdapter: "scripts/holoshell-service-supervisor.mjs"
    serviceSupervisorReceipt: ".tmp/holoshell/service-supervisor.json"
    previewHost: "apps/holoshell/prototype/local-capability-room.html"
    founderHostReceipt: ".tmp/holoshell/founder-host.json"
    profileDir: ".tmp/holoshell/native-profile"
    launchMode: "chromium_app_mode"
    productTarget: "native_holoshell_app_window"
  }

  state {
    wrapperStatus: "unknown"
    launcherPresent: false
    commandShimPresent: false
    previewHostPresent: false
    browserCandidateCount: 0
    launchable: false
    startupIntegrationPresent: false
    startupRegistered: false
    localMutationExecutionEnabled: false
    primarySurfaceOwnership: "native_wrapper_candidate"
    upstreamCapabilityEnvelopeStatus: "unknown"
    nativeCapabilityLaneCount: 0
    nativeCapabilityLanesReady: false
    upstreamTerminalEventStreamStatus: "unknown"
    nativeWindowOwnsDailyOperation: true
    browserIsBootstrapSelfTestOnly: true
    holoServicesRunThroughTerminalSupervisor: true
    visualOperatingLayerRequired: true
    nextMove: "wire_startup_integration_with_approval"
  }

  channel "holoshell:native-wrapper" {
    type: "append_only"
    priority: "critical"
    description: "Native wrapper readiness, launch boundary, and startup evidence"
  }

  room "NativeWrapperRoom" {
    label: "Native Wrapper"
    userQuestion: "Can HoloShell start from the operating system as a wrapper?"
    visualForm: "native_window_frame"
    liveFeed: "holoshell:native-wrapper"

    object "NativeWrapper" {
      type: "ui"
      uiType: "native_wrapper"
      label: "HoloShell Native Wrapper"
      status: $wrapperStatus
      launcher_present: $launcherPresent
      command_shim_present: $commandShimPresent
      preview_host_present: $previewHostPresent
      browser_candidate_count: $browserCandidateCount
      launchable: $launchable
      startup_integration_present: $startupIntegrationPresent
      startup_registered: $startupRegistered
      execute_enabled: $localMutationExecutionEnabled
      primary_surface_ownership: $primarySurfaceOwnership
      upstream_capability_envelope_status: $upstreamCapabilityEnvelopeStatus
      native_capability_lane_count: $nativeCapabilityLaneCount
      native_capability_lanes_ready: $nativeCapabilityLanesReady
      upstream_terminal_event_stream_status: $upstreamTerminalEventStreamStatus
      native_window_owns_daily_operation: $nativeWindowOwnsDailyOperation
      browser_is_bootstrap_self_test_only: $browserIsBootstrapSelfTestOnly
      holo_services_run_through_terminal_supervisor: $holoServicesRunThroughTerminalSupervisor
      next_move: $nextMove
    }
  }

  policy "WrapperIsNotStartupTakeover" {
    appliesTo: ["wrapper_launch", "startup_registration", "os_shell_replacement"]
    launcherMayOpenHoloShell: true
    launcherTargetsJetsonAppWindow: true
    launcherMayClaimOsReplacement: false
    browserSelfTestBeforePackagingClaim: true
    startupRegistrationRequiresApproval: true
    startupRegistrationAdapterRequired: true
    startupRegisteredRequiresReceipt: true
    explorerShellReplacementRequiresSeparateNativePlan: true
    receiptRequired: true
  }

  policy "WrapperMutationBoundary" {
    appliesTo: ["daemon_execute", "workflow_execute", "app_mutation"]
    wrapperLaunchIsUserGesture: true
    holoServicesRunThroughTerminalSupervisor: true
    daemonExecuteDisabledByDefault: true
    appMutationRequiresApprovalBundle: true
    destructiveActionsAllowed: false
    receiptRequired: true
  }

  policy "NativeCapabilityEnvelopeSourceOfTruth" {
    appliesTo: ["native_window", "terminal_events", "service_supervisor", "jetson_appliance", "guarded_actions"]
    sourceLayer: "HoloScript"
    upstreamCapabilityEnvelopeRequired: true
    upstreamTerminalEventStreamRequired: true
    upstreamVisualOperatingLayerRequired: true
    capabilityLaneGrantRequired: true
    visualPanelsRequired: ["service_dock", "terminal_run_timeline", "agent_utility_capsules", "hololand_node_city", "consent_command_palette"]
    browserMayValidateButNotOwn: true
    terminalEventsBeforeTerminalUi: true
    visualOperatingLayerBeforeNativeUiClaim: true
    jetsonEvidenceMustStaySeparatedFromLaptopEvidence: true
    receiptRequired: true
  }

  action consume_native_wrapper(snapshot) {
    state.wrapperStatus = snapshot.summary.status
    state.launcherPresent = snapshot.summary.launcherPresent
    state.commandShimPresent = snapshot.summary.commandShimPresent
    state.previewHostPresent = snapshot.summary.previewHostPresent
    state.browserCandidateCount = snapshot.summary.browserCandidateCount
    state.launchable = snapshot.summary.launchable
    state.startupIntegrationPresent = snapshot.summary.startupIntegrationPresent
    state.startupRegistered = snapshot.summary.startupRegistered
    state.localMutationExecutionEnabled = snapshot.summary.localMutationExecutionEnabled
    state.primarySurfaceOwnership = snapshot.summary.primarySurfaceOwnership
    state.upstreamCapabilityEnvelopeStatus = snapshot.summary.upstreamCapabilityEnvelopeStatus
    state.nativeCapabilityLaneCount = snapshot.summary.nativeCapabilityLaneCount
    state.nativeCapabilityLanesReady = snapshot.summary.nativeCapabilityLanesReady
    state.upstreamTerminalEventStreamStatus = snapshot.summary.upstreamTerminalEventStreamStatus
    state.nextMove = snapshot.summary.nextMove

    emit("holoshell:native-wrapper", {
      status: state.wrapperStatus,
      launcher_present: state.launcherPresent,
      command_shim_present: state.commandShimPresent,
      preview_host_present: state.previewHostPresent,
      browser_candidate_count: state.browserCandidateCount,
      launchable: state.launchable,
      startup_integration_present: state.startupIntegrationPresent,
      startup_registered: state.startupRegistered,
      execute_enabled: state.localMutationExecutionEnabled,
      primary_surface_ownership: state.primarySurfaceOwnership,
      upstream_capability_envelope_status: state.upstreamCapabilityEnvelopeStatus,
      native_capability_lane_count: state.nativeCapabilityLaneCount,
      native_capability_lanes_ready: state.nativeCapabilityLanesReady,
      upstream_terminal_event_stream_status: state.upstreamTerminalEventStreamStatus,
      next_move: state.nextMove,
      receiptHash: snapshot.receipt.wrapperSnapshotHash
    })
  }
}
