// Stormglass Commons Character Appearance H3F.
//
// This read-only look-development composition inherits H3E orbital fit and opts
// three civic personas into the native scalp-flow groom. Card roots follow the
// scalp tangent, widths taper toward the tip, and the source retracts the front
// hairline. This is a bounded procedural geometry witness, not strand hair,
// alpha coverage, scan-derived grooming, or a photorealism claim.

composition "Stormglass Character Appearance H3F Native Groom" {
  metadata {
    title: "Stormglass Character Appearance H3F - Native Scalp-Flow Groom"
    version: "0.1.0"
    date: "2026-07-28"
    milestone: "MV_CHARACTER_APPEARANCE_H3F_NATIVE_GROOM"
    source: "source/layers/vr/frontier/model-village/model-village-character-appearance-h3f-native-groom.holo"
    policySource: "source/proofs/model-village-character-appearance-h3f-native-groom-policy.hsplus"
    seedSource: "source/proofs/model-village-character-appearance-h3f-native-groom-seed.hs"
    inheritedH3ESource: "source/layers/vr/frontier/model-village/model-village-character-appearance-h3e-orbital-fit.holo"
    inheritedH3ESourceSha256: "6dd3d790419721cd4ddd47a6b9265414bac1644dc3faf016060fc9cd174eb028"
    upstreamHoloScriptCommit: "c273682f5a5140b0ff8cde5da89ca7bfb98c63b2"
    upstreamGroomBuilderPath: "packages/engine/src/character-render/AgentAvatarHair.ts"
    upstreamGroomBuilderSha256: "69cd7a43b3261a8e0f5848a7fbbf323db9fa3d2cbb8228feb982b9deda220955"
    upstreamCharacterHostPath: "packages/engine/src/character-render/CharacterHost.ts"
    upstreamCharacterHostSha256: "bc580f7ea846c98fcd2f1dff3f5b9cc0b637c2d40fcb5b39b2606d0649a2c1a7"
    upstreamCompositionBridgePath: "packages/engine/src/character-render/CharacterHostFromComposition.ts"
    upstreamCompositionBridgeSha256: "82f384381a9a38d37e52fa76de5b0106548a693b4bbb9d4a2f32de7453f35079"
    upstreamCompilerPath: "packages/core/src/compiler/CharacterWebGPUCompiler.ts"
    upstreamCompilerSha256: "58c13464c5dd79ecddb889fd982376c567738f243a3b02c369f05b402b8e41ea"
    projectionRole: "read_only_native_scalp_flow_groom_witness"
    artStyle: "hearthlight_biorealism"
    visualTarget: "stormglass_craft_groomed_orbital_portrait_studio"
  }

  environment {
    mode: "native_groom_look_development"
    theme: "stormglass_commons"
    backgroundColor: "#030A13"
    ambient_light: 0.14
    shadows: true
    externalNetworkAllowed: false
  }

  state {
    authority: "read_only"
    gateLevel: "H3F_NATIVE_GROOM"
    presentationProfile: "village_story_unblinded_native_groom_lookdev"
    civicPersonaCount: 3
    familyIdentityVisible: false
    adapterFamilyBinding: "absent"
    researchSeatBinding: "absent"
    liveResearchJoinAllowed: false
    canonicalWritesAllowed: false
    residentObservationWritesAllowed: false
    modelCallsAllowed: false
    networkFetchesAllowed: false
    biometricPersistenceAllowed: false
    nativeCharacterCompilerClaimed: true
    nativeNeutralAnatomicalFaceClaimed: true
    nativeLayeredOcularProfileClaimed: true
    nativeOrbitalProfileClaimed: true
    nativeGroomProfileClaimed: true
    nativeScalpTangentClaimed: true
    nativeScalpAlignedCardsClaimed: true
    nativeNeutralScalpAlignmentClaimed: true
    nativeTipTaperClaimed: true
    nativeHairlineRetractionClaimed: true
    derivedGroomReceiptClaimed: true
    presentationShaderOverrideUsed: false
    hairAlphaMaskUsed: false
    strandAlphaCoverageClaimed: false
    strandHairClaimed: false
    scanDerivedGroomClaimed: false
    productionGroomClaimed: false
    anatomicalHairAccuracyClaimed: false
    photorealismClaimed: false
    fullWorldConvergenceClaimed: false

    groomFoundation: {
      profile: "scalp-flow-v1"
      legacyComparisonProfile: "radial-cards-v1"
      scalpSurface: "neutral-anatomical-ellipsoid"
      rootTangentRadialDotP95Maximum: 0.01
      sourceAuthoredCardWidthRange: [0.0052, 0.0058]
      sourceAuthoredRootLiftRange: [0.002, 0.0025]
      sourceAuthoredTipTaperRange: [0.08, 0.14]
      sourceAuthoredHairlineBiasRange: [0.15, 0.18]
      scalpTangentRoots: true
      scalpAlignedCardBasis: true
      smoothTipTaper: true
      retractedFrontHairline: true
      derivedReceipt: true
      presentationShaderOverride: false
      hairAlphaMask: false
      strandAlphaCoverage: false
      scanDerived: false
    }

    // H4J and its successors added a hair-material record to the derived groom
    // receipt that did not exist at the originally pinned commit. H3F is the
    // pre-chroma, pre-coverage gate: it authors hair COLOR and groom GEOMETRY
    // and deliberately authors no coverage or chroma-weight control -- those
    // are H3G's subject. The values below are admitted by name as the opaque,
    // melanin-dominant baseline H3F has always claimed in prose, and are now
    // witnessed against the compiled bundle instead of asserted against
    // literals the checker wrote itself.
    groomMaterialFoundation: {
      schemaVersion: "holoscript.agent-avatar-hair-material.v2"
      shadingModel: "marschner-hair"
      coverageProfile: "opaque-v1"
      strandCoverage: 1
      alphaToCoverageRequested: false
      authoredSourceColorReachesMaterial: true
      sourceColorWeightAuthoredHere: false
      upstreamUnauthoredSourceColorWeight: 0.55
      authoredCoverageControlIntroducedBy: "H3G"
      authoredSourceColorWeightIntroducedBy: "H3G"
    }

    nativeAdmission: {
      compilerTarget: "character-webgpu"
      outputFormat: "character-webgpu/drawspec"
      fallbackAllowed: false
      repeatedCompileByteIdentityRequired: true
      exactNineNativeBundlesRequired: true
      exactEightOcularGroupsPerBundleRequired: true
      mappedGroomReceiptRequired: true
      derivedGroomReceiptRequired: true
      legacyRadialComparisonRequired: true
      neutralScalpSurfaceRequired: true
      lowerRootRadialDotRequired: true
      lowerFrontalOcclusionRequired: true
      authoredCardWidthOperative: true
      authoredRootLiftOperative: true
      authoredTipTaperOperative: true
      authoredHairlineBiasOperative: true
      compiledHairMaterialWitnessRequired: true
      compiledOpaqueCoverageRequired: true
      compiledAlphaToCoverageForbidden: true
      authoredHairColorReachesMaterialRequired: true
      unauthoredSourceColorWeightRequired: true
      fullH3Admitted: false
    }

    benchmark: {
      profileId: "native_scalp_flow_groom_desktop_h3f"
      renderWidth: 1800
      renderHeight: 720
      devicePixelRatio: 1
      simultaneousPersonaCount: 3
      visualHairLod: 2
      visualHairLodReason: "portrait_coverage_with_bounded_card_budget"
      hardwareRendererRequired: true
      d3d11BackendRequired: true
      vrBudgetMilliseconds: 11.1
    }

    goldenTargets: [
      { id: "h3f_native_groom_portraits", output: "docs/assets/model-village/model-village-character-appearance-h3f-native-groom-portraits-2026-07-28.png", width: 1800, height: 720 }
    ]
  }

  template "StormglassNativeGroomPersona" {
    @skeleton(rig: "humanoid_65", ik_enabled: true)
    @locomotion(mode: "idle", speed: 1.0)
    geometry: "avatar"
    position: [0, 0, 0]
    scale: [1, 1, 1]
    adapterFamilyBinding: "absent"
    researchSeatBinding: "absent"
    canonicalWriteAuthority: false
  }

  object "HearthKeeper" using "StormglassNativeGroomPersona" {
    @body(height: 1.82, build_scale: 1.04, skin_tone: "#B9785F")
    @face(topology: "neutral_anatomical_v2", radial_segments: 22, vertical_segments: 16, tearline: true, orbital_profile: "recessed_lids_v1", eye_recess: 0.3, lid_opening: 0.46, canthal_tilt: 0.14, ocular_profile: "layered_ocular_v1", iris_color: "#6B8C82", sclera_color: "#EEE9DF", iris_scale: 0.5, pupil_scale: 0.38, cornea_ior: 1.376)
    @subsurface_scattering(color: "#B9785F", scatter_color: "#B85F4C")
    @hair(style: "cropped_coils", color: "#2D201C", groom_profile: "scalp_flow_v1", card_width: 0.0052, root_lift: 0.0025, tip_taper: 0.08, hairline_bias: 0.17)
    @morph(targets: { smile: 0, jawOpen: 0, blink: 0 })
    @lod(levels: [
      { level: 0, distance: 0, garment_segments: 24, hair_guides: 168, hair_cards_per_guide: 2, hair_segments: 7 },
      { level: 1, distance: 8, garment_segments: 14, hair_guides: 92, hair_cards_per_guide: 1, hair_segments: 5 },
      { level: 2, distance: 20, garment_segments: 8, hair_guides: 42, hair_cards_per_guide: 1, hair_segments: 4 }
    ])
    type: "native_groom_civic_persona"
    personaId: "hearth_keeper"
    civicRole: "keeper"
    displayLabel: "Hearth Keeper"
    irisColor: "#6B8C82"
    hairColor: "#2D201C"
    nativeHairStyleId: "cropped_coils"
    groomProfile: "scalp-flow-v1"
    cardWidth: 0.0052
    rootLift: 0.0025
    tipTaper: 0.08
    hairlineBias: 0.17
  }

  object "PathTender" using "StormglassNativeGroomPersona" {
    @body(height: 1.88, build_scale: 0.98, skin_tone: "#87543F")
    @face(topology: "neutral_anatomical_v2", radial_segments: 22, vertical_segments: 16, tearline: true, orbital_profile: "recessed_lids_v1", eye_recess: 0.27, lid_opening: 0.49, canthal_tilt: 0.1, ocular_profile: "layered_ocular_v1", iris_color: "#A58B52", sclera_color: "#F0EADF", iris_scale: 0.48, pupil_scale: 0.4, cornea_ior: 1.376)
    @subsurface_scattering(color: "#87543F", scatter_color: "#874735")
    @hair(style: "short", color: "#161A20", groom_profile: "scalp_flow_v1", card_width: 0.0058, root_lift: 0.002, tip_taper: 0.14, hairline_bias: 0.18)
    @morph(targets: { smile: 0, jawOpen: 0, blink: 0 })
    @lod(levels: [
      { level: 0, distance: 0, garment_segments: 24, hair_guides: 126, hair_cards_per_guide: 2, hair_segments: 6 },
      { level: 1, distance: 8, garment_segments: 14, hair_guides: 72, hair_cards_per_guide: 1, hair_segments: 4 },
      { level: 2, distance: 20, garment_segments: 8, hair_guides: 38, hair_cards_per_guide: 1, hair_segments: 4 }
    ])
    type: "native_groom_civic_persona"
    personaId: "path_tender"
    civicRole: "wayfinder"
    displayLabel: "Path Tender"
    irisColor: "#A58B52"
    hairColor: "#161A20"
    nativeHairStyleId: "short"
    groomProfile: "scalp-flow-v1"
    cardWidth: 0.0058
    rootLift: 0.002
    tipTaper: 0.14
    hairlineBias: 0.18
  }

  object "RecordSteward" using "StormglassNativeGroomPersona" {
    @body(height: 1.78, build_scale: 1.08, skin_tone: "#D0A086")
    @face(topology: "neutral_anatomical_v2", radial_segments: 22, vertical_segments: 16, tearline: true, orbital_profile: "recessed_lids_v1", eye_recess: 0.32, lid_opening: 0.44, canthal_tilt: 0.16, ocular_profile: "layered_ocular_v1", iris_color: "#526D91", sclera_color: "#F2EBE4", iris_scale: 0.52, pupil_scale: 0.36, cornea_ior: 1.376)
    @subsurface_scattering(color: "#D0A086", scatter_color: "#C47E6A")
    @hair(style: "medium_wavy", color: "#5A3828", groom_profile: "scalp_flow_v1", card_width: 0.0052, root_lift: 0.0025, tip_taper: 0.08, hairline_bias: 0.15)
    @morph(targets: { smile: 0, jawOpen: 0, blink: 0 })
    @lod(levels: [
      { level: 0, distance: 0, garment_segments: 24, hair_guides: 160, hair_cards_per_guide: 2, hair_segments: 8 },
      { level: 1, distance: 8, garment_segments: 14, hair_guides: 88, hair_cards_per_guide: 1, hair_segments: 5 },
      { level: 2, distance: 20, garment_segments: 8, hair_guides: 42, hair_cards_per_guide: 1, hair_segments: 4 }
    ])
    type: "native_groom_civic_persona"
    personaId: "record_steward"
    civicRole: "archivist"
    displayLabel: "Record Steward"
    irisColor: "#526D91"
    hairColor: "#5A3828"
    nativeHairStyleId: "medium_wavy"
    groomProfile: "scalp-flow-v1"
    cardWidth: 0.0052
    rootLift: 0.0025
    tipTaper: 0.08
    hairlineBias: 0.15
  }
}
