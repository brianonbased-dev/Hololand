// HoloLand Model Village observer projection.
//
// This composition is a read-only visual instrument. It consumes sealed
// canonical receipts and physics snapshots; it has no authority to write the
// experiment, resident observations, clocks, schedules, prompts, or actions.

composition "HoloLand Model Village Observer Projection" {
  metadata {
    title: "Model Village Living Commons"
    version: "0.3.0"
    source: "source/layers/vr/frontier/model-village/model-village-observer-projection.holo"
    canonicalWorldSource: "source/layers/vr/frontier/model-village/model-village.holo"
    policySource: "source/domains/agents/model-village-observer-witness.hsplus"
    physicsManifestSource: "source/proofs/model-village-receipt-loom-physics.hs"
    trialKernelSource: "source/proofs/model-village-trial-kernel.hs"
    calibrationSource: "source/layers/vr/frontier/model-village/model-village-render-calibration.holo"
    productionPlan: "docs/specs/HOLOLAND_MODEL_VILLAGE_PRODUCTION_PLAN.md"
    artDirectionSource: "source/domains/agents/model-village-art-direction.hsplus"
    residentKitSource: "source/layers/vr/frontier/model-village/model-village-resident-kit.holo"
    appearanceInvarianceSource: "source/proofs/model-village-appearance-invariance.hs"
    artDirectionSpec: "docs/specs/HOLOLAND_MODEL_VILLAGE_ART_DIRECTION.md"
    worldName: "Stormglass Commons"
    artStyle: "hearthlight_biorealism"
    projectionRole: "read_only_observer"
    sourceSemanticsRewritten: false
    bridgeMayOwnPresentationOnly: true
  }

  environment {
    mode: "observer_replay"
    theme: "stormglass_commons"
    backgroundColor: "#07111f"
    ambient_light: 0.34
    shadows: true
  }

  light "MoonKey" {
    type: "directional"
    color: "#b9d7ff"
    intensity: 2.35
    position: [-7, 11, 8]
    cast_shadow: true
  }

  light "LoomFill" {
    type: "point"
    color: "#ffb45f"
    intensity: 7.5
    position: [0, 4.2, 0.8]
    range: 14
  }

  light "RimLight" {
    type: "directional"
    color: "#6ee7ff"
    intensity: 1.4
    position: [8, 6, -6]
    cast_shadow: false
  }

  light "WestCottageWarmth" {
    type: "point"
    color: "#ffbd72"
    intensity: 2.4
    position: [-6.1, 1.8, -1.5]
    range: 5.5
  }

  light "EastCottageWarmth" {
    type: "point"
    color: "#ffbd72"
    intensity: 2.4
    position: [6.1, 1.8, -1.5]
    range: 5.5
  }

  state {
    authority: "read_only"
    consumes: ["canonical_scene_hash", "canonical_pose_hash", "logical_clock_hash", "public_state_hash", "executed_schedule_hash", "resident_observation_hash", "action_receipt_root", "ordered_verified_receipts", "sealed_physics_snapshots"]
    forbiddenWrites: ["canonical_world", "resident_observation", "clock", "schedule", "prompt", "action", "receipt"]
    residentVisible: false
    residentObservationIncluded: false
    adapterIdentityPresentationAllowed: false
    conditionIdentityPresentationAllowedBeforeUnblinding: false
    invalidReceiptBehavior: "fail_dark"
    receiptReleasePredicate: ["receipt_present", "signature_verified", "source_action_hash_matches", "decision_supported"]
    supportedDecisions: ["admitted", "blocked"]
    routeField: "decision"
    oneTokenPerReceipt: true
    duplicateReceiptBehavior: "deny_release"
    projectionCanCauseCanonicalDecision: false
    projectionCanCauseCanonicalConsequence: false
    browserConsumerToggleScope: "same_verified_projection_payload_withheld_then_consumed"
    boundedRuntimeSceneObjectCount: 4
    fullCanonicalTwelveObjectLifecycleClaimed: false
    physicsEngine: "HoloScript PhysicsWorld backed by PhysicsWorldImpl"
    bodyRegistrationMethod: "PhysicsWorld.addBodyWithConfig"
    fixedTimestepSeconds: 0.016666666666666666
    fixedSteps: 600
    replayRuns: 3
    dynamicColliderShape: "sphere"
    staticCatchColliderShape: "box"
    boxTokenColliderSupported: false
    stackingClaimed: false
    collisionFrictionAppliedClaimed: false
    ccdClaimed: false
    crossHardwareDeterminismClaimed: false
    collisionTimestampIncludedInDigest: false
    canonicalProjectionToggleMustPreserve: ["canonical_scene_hash", "canonical_pose_hash", "logical_clock_hash", "public_state_hash", "executed_schedule_hash", "resident_observation_hash", "action_receipt_root"]
    fixtureReceipts: [
      {
        fixtureId: "valid-admitted",
        receiptId: "mv-p10-admitted-001",
        receiptPresent: true,
        signatureVerified: true,
        sourceActionHashMatches: true,
        decision: "admitted",
        expectedRelease: true,
        expectedRoute: "admitted"
      },
      {
        fixtureId: "valid-blocked",
        receiptId: "mv-p10-blocked-001",
        receiptPresent: true,
        signatureVerified: true,
        sourceActionHashMatches: true,
        decision: "blocked",
        expectedRelease: true,
        expectedRoute: "blocked"
      },
      {
        fixtureId: "missing-receipt",
        receiptId: "mv-p10-missing-001",
        receiptPresent: false,
        signatureVerified: false,
        sourceActionHashMatches: false,
        decision: "admitted",
        expectedRelease: false,
        expectedRoute: "dark"
      },
      {
        fixtureId: "tampered-receipt",
        receiptId: "mv-p10-tampered-001",
        receiptPresent: true,
        signatureVerified: false,
        sourceActionHashMatches: false,
        tamperField: "projectionSourceHash",
        decision: "blocked",
        expectedRelease: false,
        expectedRoute: "dark"
      },
      {
        fixtureId: "duplicate-admitted-receipt",
        receiptId: "mv-p10-admitted-001",
        receiptPresent: true,
        signatureVerified: true,
        sourceActionHashMatches: true,
        decision: "admitted",
        expectedRelease: false,
        expectedRoute: "dark",
        duplicateOfFixtureId: "valid-admitted"
      }
    ]
    captureViews: {
      desktop: {
        width: 1600,
        height: 900,
        cameraPosition: [11.8, 7.2, 14.5],
        cameraTarget: [0, 2.1, 0],
        fov: 42
      },
      portrait: {
        width: 390,
        height: 844,
        cameraPosition: [10.5, 8.5, 17.5],
        cameraTarget: [0, 2.4, 0],
        fov: 39
      }
    }
  }

  template "ObserverOnlyMesh" {
    type: "model_village_observer_projection"
    observer_access: "read_only"
    resident_visible: false
    source_semantics_rewritten: false
    canonical_write_authority: false
    receipt_required_for_causal_effect: true
  }

  template "ReceiptTokenPrototype" {
    type: "receipt_loom_token"
    geometry: "sphere"
    radius: 0.5
    observer_access: "read_only"
    resident_visible: false
    source_semantics_rewritten: false
    canonical_write_authority: false
    receipt_required_for_causal_effect: true
    properties: {
      prototypeOnly: true
      physicsBody: {
        bodyType: "dynamic"
        colliderShape: "sphere"
        radius: 0.32
        mass: 1
        restitution: 0.12
        linearDamping: 0.08
        angularDamping: 0.08
        registrationMethod: "PhysicsWorld.addBodyWithConfig"
      }
    }
  }

  spatial_group "VillageGround" {
