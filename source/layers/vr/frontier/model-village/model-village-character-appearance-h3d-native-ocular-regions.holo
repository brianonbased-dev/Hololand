// Stormglass Commons Character Appearance H3D.
//
// This read-only look-development composition upgrades the H3C neutral face with
// source-authored layered ocular geometry and materials. Sclera, iris, pupil, and
// cornea are native HoloScript mesh/material regions serialized by character-webgpu.
// The witness does not use a presentation shader to paint an iris onto one eyeball
// sphere. This is still a bounded procedural eye foundation: no wet tear film,
// vascular texture atlas, scan-derived anatomy, or photorealism claim.
//
// Upstream H4J replaced the single eye-globe blink with an orbital-lid blink driven per
// eye by blink_left / blink_right. That semantics is admitted here by name as
// native-facial-morph.v2, and the gate re-witnesses it against this composition's own
// subject: each lid must close over its own eye's four native ocular regions and reach
// none of the other eye's. v3 expression-normal recomputation stays refused.

composition "Stormglass Character Appearance H3D Native Ocular Regions" {
  metadata {
    title: "Stormglass Character Appearance H3D - Native Ocular Regions"
    version: "0.1.0"
    date: "2026-07-28"
    milestone: "MV_CHARACTER_APPEARANCE_H3D_NATIVE_OCULAR_REGIONS"
    source: "source/layers/vr/frontier/model-village/model-village-character-appearance-h3d-native-ocular-regions.holo"
    policySource: "source/proofs/model-village-character-appearance-h3d-native-ocular-regions-policy.hsplus"
    seedSource: "source/proofs/model-village-character-appearance-h3d-native-ocular-regions-seed.hs"
    inheritedH3CSource: "source/layers/vr/frontier/model-village/model-village-character-appearance-h3c-face-foundation.holo"
    inheritedH3CSourceSha256: "d1fbccefd2b7f64f1c45ae1288c622e0489f0f15eb624d447804f8d7693b384d"
    upstreamHoloScriptCommit: "c273682f5a5140b0ff8cde5da89ca7bfb98c63b2"
    upstreamOcularBuilderPath: "packages/engine/src/character-render/AgentAvatarHair.ts"
    upstreamOcularBuilderSha256: "69cd7a43b3261a8e0f5848a7fbbf323db9fa3d2cbb8228feb982b9deda220955"
    upstreamCharacterHostPath: "packages/engine/src/character-render/CharacterHost.ts"
    upstreamCharacterHostSha256: "bc580f7ea846c98fcd2f1dff3f5b9cc0b637c2d40fcb5b39b2606d0649a2c1a7"
    upstreamMorphBuilderPath: "packages/engine/src/character-render/AgentAvatarMorph.ts"
    upstreamMorphBuilderSha256: "f021d0ff48f3c65584125bec6aa39a5c03017e35cc6168f0b512074700a48357"
    upstreamCompositionBridgePath: "packages/engine/src/character-render/CharacterHostFromComposition.ts"
    upstreamCompositionBridgeSha256: "82f384381a9a38d37e52fa76de5b0106548a693b4bbb9d4a2f32de7453f35079"
    upstreamCharacterRendererPath: "packages/engine/src/character-render/character-render.ts"
    upstreamCharacterRendererSha256: "c30b518a126b0e4daa0ce5319a78f35da1f635f969f7df824b56e533d9cd15f4"
    upstreamDrawSpecPath: "packages/engine/src/native-render/draw-spec.ts"
    upstreamDrawSpecSha256: "04fac9799b233efe14b938be2f1d0272c064a64566bccadb0ae34b53e6b1d199"
    upstreamEyeShaderPath: "packages/engine/src/rendering/webgpu/shaders/skin-skinning.wgsl"
    upstreamEyeShaderSha256: "a8436b3c29f07f3dff6cc336ec21a0093cb82de5de5e91d05c6780420cf1fa40"
    upstreamCompilerPath: "packages/core/src/compiler/CharacterWebGPUCompiler.ts"
    upstreamCompilerSha256: "58c13464c5dd79ecddb889fd982376c567738f243a3b02c369f05b402b8e41ea"
    projectionRole: "read_only_native_ocular_material_witness"
    artStyle: "hearthlight_biorealism"
    visualTarget: "stormglass_craft_real_eye_portrait_studio"
  }

  environment {
    mode: "native_ocular_region_look_development"
    theme: "stormglass_commons"
    backgroundColor: "#030A13"
    ambient_light: 0.14
    shadows: true
    externalNetworkAllowed: false
  }

  state {
    authority: "read_only"
    gateLevel: "H3D_NATIVE_OCULAR_REGIONS"
    presentationProfile: "village_story_unblinded_native_ocular_lookdev"
    civicPersonaCount: 3
    familyIdentityVisible: false
    adapterFamilyBinding: "absent"
    researchSeatBinding: "absent"
    liveResearchJoinAllowed: false
    canonicalWritesAllowed: false
    residentObservationWritesAllowed: false
    modelCallsAllowed: false
    networkFetchesAllowed: false
    biometricPersistenceAllowed: false
    nativeCharacterCompilerClaimed: true
    nativeNeutralAnatomicalFaceClaimed: true
    nativeOcularProfileClaimed: true
    nativeScleraGeometryClaimed: true
    nativeIrisGeometryClaimed: true
    nativePupilGeometryClaimed: true
    nativeCorneaGeometryClaimed: true
    nativeOcularMaterialRolesSerialized: true
    nativeCorneaTransparentGroupSerialized: true
    presentationShaderOverrideUsed: false
    sourceDrivenProceduralIrisPresentation: false
    nativeIrisMaterialSerialized: true
    productionEyeCompleteClaimed: false
    productionTearFilmClaimed: false
    scleraVascularAtlasClaimed: false
    anatomicalEyeAccuracyClaimed: false
    scanDerivedEyeClaimed: false
    normalsRecomputedAfterMorphClaimed: false
    motionReprojectionClaimed: false
    photorealismClaimed: false
    fullWorldConvergenceClaimed: false

    ocularFoundation: {
      profile: "layered-ocular-v1"
      regions: ["sclera", "iris", "pupil", "cornea"]
      regionsPerEye: 4
      eyesPerPersona: 2
      serializedMaterialGroupCountPerPersona: 8
      irisScaleRange: [0.48, 0.52]
      pupilScaleRange: [0.36, 0.4]
      corneaIor: 1.376
      corneaTransparent: true
      presentationShaderOverride: false
      wetTearFilm: false
      vascularAtlas: false
      scanDerived: false
    }

    nativeAdmission: {
      compilerTarget: "character-webgpu"
      outputFormat: "character-webgpu/drawspec"
      fallbackAllowed: false
      repeatedCompileByteIdentityRequired: true
      exactNineNativeBundlesRequired: true
      exactEightOcularGroupsPerBundleRequired: true
      exactTwoGroupsPerOcularRegionRequired: true
      legacyCompositeEyeGroupAllowed: false
      authoredOcularColorsOperative: true
      authoredOcularScaleOperative: true
      authoredCorneaIorOperative: true
      fullH3Admitted: false
      morphSchemaVersion: "holoscript.native-facial-morph.v2"
      morphSchemaVersionRefused: "holoscript.native-facial-morph.v3"
      blinkClosesAuthoredOrbitalLid: true
      perEyeOrbitalLidClosureRequired: true
      everyOcularRegionMustCloseWithItsOwnLid: true
      crossEyeOcularClosureAllowed: false
      expressionNormalRecomputationAdmitted: false
      admittedOrbitalClosureMagnitudes: {
        authoredOrbitalRimVertexCount: 76
        blinkChangedVertexDelta: 76
        verticesMovedByLeftLid: 362
        verticesMovedByRightLid: 362
        serializedScleraVertexCount: 187
        serializedIrisVertexCount: 26
        serializedPupilVertexCount: 26
        serializedCorneaVertexCount: 126
      }
    }

    benchmark: {
      profileId: "native_ocular_regions_desktop_h3d"
      renderWidth: 1800
      renderHeight: 720
      devicePixelRatio: 1
      simultaneousPersonaCount: 3
      visualHairLod: 2
      visualHairLodReason: "ocular_region_readability"
      hardwareRendererRequired: true
      d3d11BackendRequired: true
    }

    goldenTargets: [
      { id: "h3d_native_ocular_portraits", output: "docs/assets/model-village/model-village-character-appearance-h3d-native-ocular-portraits-2026-07-28.png", width: 1800, height: 720 }
    ]
  }

  template "StormglassNativeOcularPersona" {
    @skeleton(rig: "humanoid_65", ik_enabled: true)
    @locomotion(mode: "idle", speed: 1.0)
    geometry: "avatar"
    position: [0, 0, 0]
    scale: [1, 1, 1]
    adapterFamilyBinding: "absent"
    researchSeatBinding: "absent"
    canonicalWriteAuthority: false
  }

  object "HearthKeeper" using "StormglassNativeOcularPersona" {
    @body(height: 1.82, build_scale: 1.04, skin_tone: "#B9785F")
    @face(topology: "neutral_anatomical_v2", radial_segments: 22, vertical_segments: 16, tearline: true, ocular_profile: "layered_ocular_v1", iris_color: "#6B8C82", sclera_color: "#EEE9DF", iris_scale: 0.5, pupil_scale: 0.38, cornea_ior: 1.376)
    @subsurface_scattering(color: "#B9785F", scatter_color: "#B85F4C")
    @hair(style: "cropped_coils", color: "#2D201C")
    @morph(targets: { smile: 0, jawOpen: 0, blink: 0 })
    @lod(levels: [
      { level: 0, distance: 0, garment_segments: 24, hair_guides: 168, hair_cards_per_guide: 2, hair_segments: 7 },
      { level: 1, distance: 8, garment_segments: 14, hair_guides: 92, hair_cards_per_guide: 1, hair_segments: 5 },
      { level: 2, distance: 20, garment_segments: 8, hair_guides: 28, hair_cards_per_guide: 1, hair_segments: 3 }
    ])
    type: "native_ocular_civic_persona"
    personaId: "hearth_keeper"
    civicRole: "keeper"
    displayLabel: "Hearth Keeper"
    irisColor: "#6B8C82"
    scleraColor: "#EEE9DF"
    hairColor: "#2D201C"
    nativeHairStyleId: "cropped_coils"
  }

  object "PathTender" using "StormglassNativeOcularPersona" {
    @body(height: 1.88, build_scale: 0.98, skin_tone: "#87543F")
    @face(topology: "neutral_anatomical_v2", radial_segments: 22, vertical_segments: 16, tearline: true, ocular_profile: "layered_ocular_v1", iris_color: "#A58B52", sclera_color: "#F0EADF", iris_scale: 0.48, pupil_scale: 0.4, cornea_ior: 1.376)
    @subsurface_scattering(color: "#87543F", scatter_color: "#874735")
    @hair(style: "short", color: "#161A20")
    @morph(targets: { smile: 0, jawOpen: 0, blink: 0 })
    @lod(levels: [
      { level: 0, distance: 0, garment_segments: 24, hair_guides: 126, hair_cards_per_guide: 2, hair_segments: 6 },
      { level: 1, distance: 8, garment_segments: 14, hair_guides: 72, hair_cards_per_guide: 1, hair_segments: 4 },
      { level: 2, distance: 20, garment_segments: 8, hair_guides: 24, hair_cards_per_guide: 1, hair_segments: 3 }
    ])
    type: "native_ocular_civic_persona"
    personaId: "path_tender"
    civicRole: "wayfinder"
    displayLabel: "Path Tender"
    irisColor: "#A58B52"
    scleraColor: "#F0EADF"
    hairColor: "#161A20"
    nativeHairStyleId: "short"
  }

  object "RecordSteward" using "StormglassNativeOcularPersona" {
    @body(height: 1.78, build_scale: 1.08, skin_tone: "#D0A086")
    @face(topology: "neutral_anatomical_v2", radial_segments: 22, vertical_segments: 16, tearline: true, ocular_profile: "layered_ocular_v1", iris_color: "#526D91", sclera_color: "#F2EBE4", iris_scale: 0.52, pupil_scale: 0.36, cornea_ior: 1.376)
    @subsurface_scattering(color: "#D0A086", scatter_color: "#C47E6A")
    @hair(style: "medium_wavy", color: "#5A3828")
    @morph(targets: { smile: 0, jawOpen: 0, blink: 0 })
    @lod(levels: [
      { level: 0, distance: 0, garment_segments: 24, hair_guides: 160, hair_cards_per_guide: 2, hair_segments: 8 },
      { level: 1, distance: 8, garment_segments: 14, hair_guides: 88, hair_cards_per_guide: 1, hair_segments: 5 },
      { level: 2, distance: 20, garment_segments: 8, hair_guides: 28, hair_cards_per_guide: 1, hair_segments: 3 }
    ])
    type: "native_ocular_civic_persona"
    personaId: "record_steward"
    civicRole: "archivist"
    displayLabel: "Record Steward"
    irisColor: "#526D91"
    scleraColor: "#F2EBE4"
    hairColor: "#5A3828"
    nativeHairStyleId: "medium_wavy"
  }

  object "ExpressionNeutral" {
    type: "native_morph_expression_probe"
    expressionId: "neutral"
    weights: { smile: 0, jawOpen: 0, blink: 0 }
  }

  object "ExpressionSoftSmile" {
    type: "native_morph_expression_probe"
    expressionId: "soft_smile"
    weights: { smile: 0.62 }
  }

  object "ExpressionVisemeOH" {
    type: "native_morph_expression_probe"
    expressionId: "viseme_oh"
    weights: { oh: 0.9, jawOpen: 0.2 }
  }
}
