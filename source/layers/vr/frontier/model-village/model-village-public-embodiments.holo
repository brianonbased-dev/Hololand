      material: { color: "#46545E", metalness: 0.05, roughness: 0.86 }
      properties: {
        publicEmbodimentId: "public-embodiment-google"
        publicDisplayName: "Gemini"
        familyId: "google"
        agentSurfaceId: "gemini-antigravity"
        modelFamily: "gemini"
