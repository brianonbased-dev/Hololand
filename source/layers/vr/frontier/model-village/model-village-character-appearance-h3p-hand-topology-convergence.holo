// Stormglass Commons Character Appearance H3P.
//
// Four symbolic model-family residents exercise the sovereign HoloScript
// composition -> CharacterHost -> native WebGPU renderer path. The renderer
// plate is a bounded hand/material witness, not a provider-model binding,
// biometric likeness, photorealism claim, or whole-world convergence claim.

composition "Stormglass Character Appearance H3P Hand Topology Convergence" {
  metadata {
    title: "Stormglass Character Appearance H3P - Hand Topology Convergence"
    version: "0.1.0"
    date: "2026-07-29"
    milestone: "MV_CHARACTER_APPEARANCE_H3P_HAND_TOPOLOGY_CONVERGENCE"
    source: "source/layers/vr/frontier/model-village/model-village-character-appearance-h3p-hand-topology-convergence.holo"
