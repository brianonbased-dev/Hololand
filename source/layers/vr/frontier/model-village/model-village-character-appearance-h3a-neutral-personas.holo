// Stormglass Commons Character Appearance H3A.
//
// A read-only visual target for neutral civic faces, hands, eyes, skin, hair
// silhouettes, and expression deltas. This is deliberately a shadow consumer:
// its preview geometry is source-owned, so it cannot promote full H3 or enter
// live research.
//
// HISTORICAL BOUNDARY, RESOLVED 2026-08-16. H3A was authored when upstream
// HoloScript reported @hair(style) as having no geometry channel and @morph as
// having no FACS/morph-target channel. H4J (0275f8d4c) landed both. The gap
// record below is frozen as history and is no longer re-derived; the gate now
// PROVES the native channels operative by executing them, and delegates native
// channel coverage to H3B. H3A is retained, not retired, and that refusal is PROVEN
// each run rather than asserted: the checker mutates each property below in H3B's own
// contract and requires H3B's validator not to notice. H3A uniquely holds the
// dermal atlas custody contract, the absolute per-persona triangle budgets, the
// benchmark protocol shape, civic-role binding, silhouette and atlas-cell
// uniqueness, the H2 lineage pins, face/eye tracking defaults, the shared
// motion/capability invariants, the promotion/replacement boundary, and the
// accessibility evidence -- none of which H3B asserts.

composition "Stormglass Character Appearance H3A Neutral Personas" {
  metadata {
    title: "Stormglass Character Appearance H3A - Neutral Persona Shadow Target"
    version: "0.1.0"
    date: "2026-07-27"
    milestone: "MV_CHARACTER_APPEARANCE_H3A_SHADOW_TARGET"
    source: "source/layers/vr/frontier/model-village/model-village-character-appearance-h3a-neutral-personas.holo"
    policySource: "source/proofs/model-village-character-appearance-h3a-neutral-personas-policy.hsplus"
    seedSource: "source/proofs/model-village-character-appearance-h3a-neutral-personas-seed.hs"
    appearancePlan: "docs/specs/HOLOLAND_MODEL_VILLAGE_CHARACTER_APPEARANCE_PLAN.md"
    appearancePlanSha256: "ac3535ce75aac5b45feef6ea11f9e9e09e3e001fc23defb5119e71ad1fa930c8"
    inheritedH2Source: "source/layers/vr/frontier/model-village/model-village-character-appearance-h2-family-mantles.holo"
    inheritedH2SourceSha256: "9ac3fc87acfecc1555e5de1a5c0445f1deab2f7ff9a141a76d25c3dbd2cfd5b2"
    inheritedH2Manifest: "source/layers/vr/frontier/model-village/model-village-character-appearance-h2-family-mantles-manifest.holo"
    inheritedH2ManifestSha256: "49eeaf4dfd16f80a4e35414c5aa29c2c294f34ff2aa317b25d6f871f21992d8b"
    inheritedH2Report: "docs/reports/HOLOLAND_MODEL_VILLAGE_CHARACTER_APPEARANCE_H2_2026-07-27.md"
    inheritedH2ReportSha256: "0594f003d0730677babf5984ae7f2c3e90e850e18e8cedfa9509e14e9b10cc27"
    upstreamHoloScriptCommit: "721b4608da5d3752956d978108fa852cb2740b6d"
    upstreamCharacterHostPath: "packages/engine/src/character-render/CharacterHostFromComposition.ts"
    upstreamCharacterHostSha256: "82f384381a9a38d37e52fa76de5b0106548a693b4bbb9d4a2f32de7453f35079"
    upstreamHairBuilderPath: "packages/engine/src/character-render/AgentAvatarHair.ts"
    upstreamHairBuilderSha256: "69cd7a43b3261a8e0f5848a7fbbf323db9fa3d2cbb8228feb982b9deda220955"
    historicalUpstreamHoloScriptCommit: "9153ab98a87decffc38876070ca8bfc04b179f01"
    historicalUpstreamCharacterHostSha256: "f451aba16f6af6fec204b3e8d728b996d53274ac5e3f393399df841734e85131"
    historicalUpstreamHairBuilderSha256: "04148fe420429ae5d3994ef7c91b163ab6be8f83ec204f1051d19e77aa6acd2b"
    nativeChannelGapClosedByUpstreamCommit: "0275f8d4c"
    successorGate: "H3B"
    successorSource: "source/layers/vr/frontier/model-village/model-village-character-appearance-h3b-native-channels.holo"
    projectionRole: "read_only_neutral_persona_shadow_target"
    artStyle: "hearthlight_biorealism"
    characterStyle: "stormglass_craftfolk_soft_faceted_civic"
  }

  environment {
    mode: "neutral_persona_look_development"
    theme: "stormglass_commons"
    backgroundColor: "#06101D"
    ambient_light: 0.18
    shadows: true
    externalNetworkAllowed: false
  }

  state {
    authority: "read_only"
    gateLevel: "H3A"
    fullH3PromotionStatus: "historical_boundary_satisfied_native_channels_carried_by_h3b"
    presentationProfile: "village_story_unblinded_shadow_only"
    productionProfilePromotionClaimed: false
    publicFirstReleaseReplacementClaimed: false
    civicPersonaCount: 3
    familyIdentityVisible: false
    adapterFamilyBinding: "absent"
    sharedMotionQualityInvariant: true
    sharedCapabilityInvariant: true
    researchSeatBinding: "absent"
    liveResearchJoinAllowed: false
    canonicalWritesAllowed: false
    residentObservationWritesAllowed: false
    modelCallsAllowed: false
    networkFetchesAllowed: false
    faceTrackingEnabledByDefault: false
    eyeTrackingEnabledByDefault: false
    biometricPersistenceAllowed: false
    sourceOwnedHairGeometryBridgePreview: true
    nativeHairStyleChannelClaimed: false
    sourceOwnedExpressionDeltaBridgePreview: true
    nativeMorphTargetChannelClaimed: false
    nativeSubsurfaceScatteringClaimedByBrowser: false
    productionFaceCompleteClaimed: false
    photorealismClaimed: false
    fullWorldConvergenceClaimed: false

    // Frozen history + current operative fact. The historical block records what
    // was true when H3A was authored and is never re-derived from upstream source
    // text; the current block is PROVEN BY EXECUTION each run (see
    // proveUpstreamNativeChannels in the checker), not asserted by hand.
    upstreamNativeAdmission: {
      historical: {
        holoScriptCommit: "9153ab98a87decffc38876070ca8bfc04b179f01"
        authoredHairStyleGeometryOperative: false
        authoredMorphFacsOperative: false
        characterHostHairStyleReport: "has_no_geometry_channel_yet"
        characterHostMorphReport: "no_facs_morph_target_channel_yet"
      }
      current: {
        holoScriptCommit: "721b4608da5d3752956d978108fa852cb2740b6d"
        gapClosedByUpstreamCommit: "0275f8d4c"
        hairColorOperative: true
        defaultProceduralHairOperative: true
        authoredHairStyleGeometryOperative: true
        authoredMorphFacsOperative: true
        h3aClaimsNativeChannels: false
        nativeChannelCoverageGate: "H3B"
      }
      fullH3Admitted: false
    }

    // The retire-vs-restate decision, declared so the gate can refuse it rather than
    // merely record it. retirementRefused: true asserts H3B carries NONE of the
    // properties below; setting it to false asserts H3B carries ALL of them. Either way
    // the checker proves the claim by mutating each property in H3B's own contract and
    // asking H3B's validator whether it notices -- see proveSupersessionBoundary.
    supersessionBoundary: {
      retirementRefused: true
      refusedProperties: [
        "dermalAtlasCustody",
        "absolutePersonaTriangleBudgets",
        "benchmarkProtocolShape",
        "civicRoleBinding",
        "silhouetteAndAtlasCellUniqueness",
        "h2LineagePins",
        "faceAndEyeTrackingDefaults",
        "sharedMotionAndCapabilityInvariants",
        "promotionReplacementBoundary",
        "accessibilityEvidence"
      ]
      refusedReason: "H3B does not assert the dermal atlas custody contract, absolute per-persona triangle budgets, benchmark protocol shape, civic-role binding, silhouette or dermal-atlas-cell uniqueness, H2 lineage pins, face/eye tracking defaults, shared motion and capability invariants, the promotion/replacement boundary, or accessibility evidence"
    }

    atlas: {
      algorithm: "stormglass_neutral_dermal_atlas_v1"
      seed: 271828
      columns: 3
      rows: 1
      albedoSize: [2048, 2048]
      normalSize: [2048, 2048]
      surfaceMaskSize: [1024, 1024]
      externalUris: []
    }

    sharedSurface: {
      faceGeometry: "soft_faceted_anatomical_ellipsoid"
      handGeometry: "soft_faceted_capsule"
      scleraGeometry: "refractive_sphere"
      irisGeometry: "recessed_disc"
      corneaIor: 1.376
      skinRoughness: 0.52
      skinClearcoat: 0.035
      browserMaterialModel: "physical_wrap_fill_approximation"
      nativeSkinSssTarget: "skin_sss"
      expressionPreviewMode: "source_delta_bridge_only"
    }

    lod: {
      levels: [0, 1, 2]
      distancesMeters: [0, 8, 20]
      faceRadialSegments: [28, 18, 10]
      faceHeightSegments: [20, 12, 8]
      hairRadialSegments: [18, 12, 6]
      maximumPersonaTriangles: [12000, 5000, 1800]
      monotonicTopologyReductionRequired: true
      sourceAuthoredVisibilityRequired: true
      secondLodAuthorityAllowed: false
    }

    benchmark: {
      profileId: "neutral_persona_shadow_desktop_h3a"
      renderWidth: 1800
      renderHeight: 1000
      devicePixelRatio: 1
      warmupFrames: 300
      measuredFrames: 600
      simultaneousPersonaCount: 3
      maximumRafP95Milliseconds: 25
      maximumRenderSubmitP95Milliseconds: 8
      maximumDroppedFrameRatio: 0.02
      hardwareRendererRequired: true
      d3d11BackendRequired: true
    }

    resetEvents: [
      "camera_cut",
      "lod_change",
      "expression_change",
      "persona_change",
      "profile_change"
    ]

    goldenTargets: [
      { id: "h3a_persona_close", output: "docs/assets/model-village/model-village-character-appearance-h3a-neutral-personas-2026-07-27.png", width: 2400, height: 900 },
      { id: "h3a_expression_grid", output: "docs/assets/model-village/model-village-character-appearance-h3a-expression-preview-2026-07-27.png", width: 2400, height: 900 },
      { id: "h3a_lod_grid", output: "docs/assets/model-village/model-village-character-appearance-h3a-lods-2026-07-27.png", width: 2400, height: 600 },
      { id: "h3a_accessibility", output: "docs/assets/model-village/model-village-character-appearance-h3a-accessibility-2026-07-27.png", width: 2400, height: 600 }
    ]
  }

