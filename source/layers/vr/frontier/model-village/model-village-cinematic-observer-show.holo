  object "BeatStormglassBeforeTheProof" {
    beatId: "stormglass_before_the_proof"
    beatIndex: 0
    durationMs: 7000
    actId: "act_one_village_receipts"
    evidenceLane: "v4_run"
    evidenceLaneLabel: "V4 RUN RECEIPT"
    evidenceKey: "observer_stage"
    evidenceValue: "read_only"
    causalSource: "v4_run_observer_projection"
    eyebrow: "BEAT 01 / THE WITNESS ARRIVES"
    title: "Stormglass Before the Proof"
    presenterCopy: "Six public mantles gather at blue hour. The camera enters as an observer only; the village cannot see the show and the show cannot change the village."
    audioDescription: "A wide blue-hour view establishes six faceless model-family mantles around the glowing Stormglass Commons."
    sealedClothPhaseSeconds: 0.6
    physicsFrameStep: 42
    cameraScale: 1.0
    cameraTranslateXPercent: 0.0
    cameraTranslateYPercent: 0.0
    cameraOriginXPercent: 50
    cameraOriginYPercent: 50
    cameraLens: "wide_commons"
    annotationGlyph: "six_fold_hearth"
    crossLaneCausalityAllowed: false
    canonicalWriteAuthority: false
    causalEffect: false
  }

  object "BeatWaterGiven" {
