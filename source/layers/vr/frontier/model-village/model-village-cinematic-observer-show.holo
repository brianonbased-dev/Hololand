    causalSource: "v4_run_living_commons_projection"
    eyebrow: "BEAT 02 / THE CISTERN"
    title: "Water Given"
    presenterCopy: "The cistern brightens from the sealed V4 RUN public-water field. This is receipt projection, not a cinematic simulation of generosity."
    audioDescription: "The frame cuts closer to the cyan cistern and its visible water-level witness on the left side of the Commons."
    sealedClothPhaseSeconds: 0.6
    physicsFrameStep: 42
    cameraScale: 1.22
    cameraTranslateXPercent: 10.0
    cameraTranslateYPercent: -1.0
    cameraOriginXPercent: 38
    cameraOriginYPercent: 50
