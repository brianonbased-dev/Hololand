    causalSource: "v4_run_boundary_receipt_projection"
    eyebrow: "BEAT 04 / THE WARD"
    title: "The Boundary Holds"
    presenterCopy: "The violet ward records a blocked external message from the V4 RUN. It is protection made visible, with no prompt, schedule, or observation write edge."
