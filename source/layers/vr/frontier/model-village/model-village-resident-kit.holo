// Stormglass Craftfolk neutral resident-kit source.
//
// This is the Q0 spatial and research-appearance manifest for the six fixed
// Model Village personas. Family identity belongs to the separately gated
// public embodiment overlay and cannot enter a live research projection.
// Capsule geometry is an honest proxy. The authored humanoid GLB/VRM kit,
// facial rig, textures, and animation remain targets.

composition "HoloLand Model Village Neutral Stormglass Craftfolk Kit" {
  metadata {
    title: "Neutral Stormglass Craftfolk"
    version: "1.1.0"
    source: "source/layers/vr/frontier/model-village/model-village-resident-kit.holo"
    artDirectionSource: "source/domains/agents/model-village-art-direction.hsplus"
    appearanceInvarianceSource: "source/proofs/model-village-appearance-invariance.hs"
    canonicalWorldSource: "source/layers/vr/frontier/model-village/model-village.holo"
    observerProjectionSource: "source/layers/vr/frontier/model-village/model-village-observer-projection.holo"
    publicEmbodimentOverlaySource: "source/layers/vr/frontier/model-village/model-village-public-embodiments.holo"
    neutralResearchConceptAsset: "docs/assets/model-village/model-village-stormglass-craftfolk-lineup-2026-07-25.png"
    artStyle: "hearthlight_biorealism"
    assetTier: "q0_proxy"
    authoredProductionAssetsObserved: false
  }

  environment {
    mode: "resident_kit_lineup"
    theme: "stormglass_commons"
    backgroundColor: "#07111F"
    ambient_light: 0.32
    shadows: true
  }

  light "StudioMoonKey" {
    type: "directional"
    color: "#B9D7FF"
    intensity: 1.8
    position: [-5, 8, 6]
    cast_shadow: true
  }

  light "StudioHearthRim" {
    type: "directional"
    color: "#FFB45F"
    intensity: 0.9
    position: [6, 5, -4]
    cast_shadow: false
  }

  state {
    worldName: "Stormglass Commons"
    artStyle: "hearthlight_biorealism"
    residentCount: 6
    sharedRig: "stormglass_craftfolk_humanoid_shared"
    sharedNeutralClips: ["idle", "listen", "propose", "settle"]
    currentGeometry: "capsule_proxy"
    productionGeometry: "authored_humanoid_glb_or_vrm_target"
    presentationProfile: "research_live_blinded"
    supportedPresentationProfiles: [
      "village_story_unblinded",
      "research_live_blinded",
      "research_replay_postlock"
    ]
    activeIdentitySource: "research_alias"
    providerIdentityVisible: false
    modelIdentityVisible: false
    familyIdentityVisible: false
    publicEmbodimentOverlayLoaded: false
    publicEmbodimentOverlayAllowedInLiveResearch: false
    exactModelRevisionVisible: false
    appearanceAssignmentInvariant: true
    rolePropsGrantExclusiveCapability: false
  }

  template "StormglassCraftfolkProxy" {
    type: "model_village_resident_visual_proxy"
    geometry: "capsule"
    material: "shared_basalt_cloth_proxy"
    visible_to_observers: true
    model_identity_blinded: true
    provider_identity_blinded: true
    family_identity_blinded: true
    neutral_seat_mantle_required: true
    family_embodiment_overlay_loaded: false
    public_state_only: true
    action_receipt_required: true
    asset_status: "q0_proxy_production_asset_not_custodied"
  }

  spatial_group "ResidentLineup" {
    object "StormglassResident01" using "StormglassCraftfolkProxy" {
      label: "Resident 01"
      position: [-5.0, 1.0, 0]
      scale: [0.50, 1.50, 0.50]
      material: { color: "#46545E", metalness: 0.05, roughness: 0.86 }
      properties: {
        residentId: "resident-01"
        personaId: "persona-01"
        seatId: "seat-01"
        displayName: "Resident 01"
        researchAlias: "Resident 01"
        villageRole: "water_steward"
        silhouetteId: "willow_crescent"
        glyphId: "open_droplet"
        accentColor: "#77D4C8"
        roleProp: "ceramic_water_measure"
        neutralSeatMantleId: "neutral-seat-mantle-01"
        appearanceManifestId: "stormglass-appearance-01-v1"
        assignmentInvariant: true
        adapterIdentity: "absent"
      }
    }

    object "StormglassResident02" using "StormglassCraftfolkProxy" {
      label: "Resident 02"
      position: [-3.0, 1.0, 0]
      scale: [0.72, 1.22, 0.64]
