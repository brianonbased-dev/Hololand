  object "ClaimBoundary" {
    provedWhenReceipted: [
      "two_holoscript_owned_discrete_cinematic_beats",
      "exact_camera_annotation_phase_and_character_pixel_replay",
      "desktop_and_portrait_sequence_contact_sheets",
