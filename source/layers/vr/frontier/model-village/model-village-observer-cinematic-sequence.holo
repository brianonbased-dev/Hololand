      "mv_v7_observer_family_admission_sha256",
      "observer_canonical_fields_sha256",
      "presentation_profile",
      "independent_project_disclosure"
    ]
    failNeutral: true
    failNeutralDestination: "unchanged_neutral_observer"
    deniedProfileMayInstantiateNamedRenderer: false
    invalidAdmissionMayInstantiateNamedRenderer: false
    mayWriteCanonicalWorld: false
    mayWriteResidentObservation: false
  }

  object "BeatTheCommonsWakes" {
    beatId: "the_commons_wakes"
    beatIndex: 0
    durationMs: 3200
    eyebrow: "BEAT 01 / ARRIVAL"
    title: "The Commons Wakes"
    presenterCopy: "Hearthlight crosses six public mantles. Beneath the exhibit, the verified village replay remains unchanged and unable to observe the presentation."
    audioDescription: "A wide blue-hour view reveals six faceless family mantles arranged across the illuminated Stormglass Commons."
    sealedClothPhaseSeconds: 0.6
    cameraScale: 1.0
    cameraTranslateXPercent: 0.0
    cameraTranslateYPercent: 0.0
    cameraOriginXPercent: 50
    cameraOriginYPercent: 50
    cameraLens: "wide_commons"
    annotationGlyph: "six_fold_hearth"
    optionalAudioCueHz: 196
    optionalAudioCueDurationMs: 420
    canonicalWriteAuthority: false
    causalEffect: false
  }

  object "BeatProofInTheLight" {
    beatId: "proof_in_the_light"
    beatIndex: 1
    durationMs: 3600
    eyebrow: "BEAT 02 / WITNESS"
    title: "Proof in the Light"
    presenterCopy: "The lens closes toward the Receipt Loom as the sealed 1.2-second cloth phase resolves. Camera, caption, and cue remain presentation-only."
    audioDescription: "The exhibit moves to a tighter centered frame while the six mantles hold a sealed later cloth pose."
    sealedClothPhaseSeconds: 1.2
    cameraScale: 1.12
    cameraTranslateXPercent: 0.0
    cameraTranslateYPercent: -1.8
    cameraOriginXPercent: 50
    cameraOriginYPercent: 48
    cameraLens: "receipt_loom_push"
    annotationGlyph: "receipt_loom"
    optionalAudioCueHz: 293.66
    optionalAudioCueDurationMs: 520
    canonicalWriteAuthority: false
    causalEffect: false
  }

  object "PresenterAccessibilityDeck" {
    playbackControls: ["previous", "next", "replay"]
    keyboardControls: ["ArrowLeft", "ArrowRight", "Home"]
    reducedMotionDefault: true
    continuousCameraMotion: false
    flashingEffects: false
    captionsAlwaysVisible: true
    captionsUseColorAlone: false
