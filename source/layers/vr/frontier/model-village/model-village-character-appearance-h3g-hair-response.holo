    projectionRole: "read_only_native_hair_coverage_response_witness"
    artStyle: "hearthlight_biorealism"
    visualTarget: "stormglass_craft_fiber_highlight_portrait_studio"
  }

  environment {
    mode: "native_hair_response_look_development"
    theme: "stormglass_commons"
    backgroundColor: "#030A13"
    ambient_light: 0.14
    shadows: true
    externalNetworkAllowed: false
