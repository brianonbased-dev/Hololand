    hairResponseFoundation: {
      groomProfile: "scalp-flow-v1"
      coverageProfile: "alpha-to-coverage-v1"
      opaqueComparisonProfile: "opaque-v1"
      sourceAuthoredStrandCoverageRange: [0.8, 0.86]
      sourceAuthoredEdgeSoftnessRange: [0.1, 0.14]
      sourceAuthoredAnisotropyStrengthRange: [0.84, 0.9]
      sourceAuthoredLongitudinalShiftRange: [0.06, 0.12]
      sourceAuthoredChromaWeightRange: [0.5, 0.7]
      hairMaterialReceiptSchema: "holoscript.agent-avatar-hair-material.v2"
      sourceChromaWeightAuthored: true
      sourceChromaWeightUpstreamDefaulted: false
      cardWidthUvAttribute: "card-width"
      tangentAttribute: "strand-flow"
      multisampleCount: 4
      alphaToCoverageRequested: true
      analyticNativeCoverage: true
      tangentAwareDualLobe: true
      longitudinalLobeShift: true
      derivedMaterialReceipt: true
      presentationShaderOverride: false
      presentationMaterialBridge: true
      presentationAlphaMap: true
      externalHairTexture: false
      strandHair: false
      scanDerived: false
    }

    nativeAdmission: {
      compilerTarget: "character-webgpu"
      outputFormat: "character-webgpu/drawspec"
      fallbackAllowed: false
      repeatedCompileByteIdentityRequired: true
      exactNineNativeBundlesRequired: true
      exactEightOcularGroupsPerBundleRequired: true
      mappedGroomReceiptRequired: true
      derivedGroomReceiptRequired: true
      mappedHairMaterialReceiptRequired: true
      derivedHairMaterialReceiptRequired: true
      opaqueCoverageComparisonRequired: true
      cardWidthUvOperative: true
      authoredStrandCoverageOperative: true
      authoredEdgeSoftnessOperative: true
      authoredAnisotropyStrengthOperative: true
      authoredLongitudinalShiftOperative: true
      authoredSourceColorWeightOperative: true
      sourceChromaRoundTripRequired: true
      hairMaterialReceiptSchemaRequired: "holoscript.agent-avatar-hair-material.v2"
      alphaToCoverageRequestedRequired: true
      multisampleCountRequired: 4
      fullH3Admitted: false
    }

    benchmark: {
      profileId: "native_hair_coverage_response_desktop_h3g"
      renderWidth: 1800
      renderHeight: 720
      devicePixelRatio: 1
      simultaneousPersonaCount: 3
      visualHairLod: 1
      visualHairLodReason: "close_portrait_material_response_with_bounded_mid_tier_card_budget"
      hardwareRendererRequired: true
      d3d11BackendRequired: true
      vrBudgetMilliseconds: 11.1
    }

    goldenTargets: [
      { id: "h3g_native_hair_response_portraits", output: "docs/assets/model-village/model-village-character-appearance-h3g-hair-response-portraits-2026-07-28.png", width: 1800, height: 720 }
    ]
  }

  template "StormglassNativeHairResponsePersona" {
    @skeleton(rig: "humanoid_65", ik_enabled: true)
    @locomotion(mode: "idle", speed: 1.0)
    geometry: "avatar"
    position: [0, 0, 0]
    scale: [1, 1, 1]
    adapterFamilyBinding: "absent"
    researchSeatBinding: "absent"
    canonicalWriteAuthority: false
  }

  object "HearthKeeper" using "StormglassNativeHairResponsePersona" {
    @body(height: 1.82, build_scale: 1.04, skin_tone: "#B9785F")
    @face(topology: "neutral_anatomical_v2", radial_segments: 22, vertical_segments: 16, tearline: true, orbital_profile: "recessed_lids_v1", eye_recess: 0.3, lid_opening: 0.46, canthal_tilt: 0.14, ocular_profile: "layered_ocular_v1", iris_color: "#6B8C82", sclera_color: "#EEE9DF", iris_scale: 0.5, pupil_scale: 0.38, cornea_ior: 1.376)
    @subsurface_scattering(color: "#B9785F", scatter_color: "#B85F4C")
