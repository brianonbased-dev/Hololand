    upstreamNativeRendererPath: "packages/engine/src/character-render/character-render.ts"
    upstreamNativeRendererSha256: "c30b518a126b0e4daa0ce5319a78f35da1f635f969f7df824b56e533d9cd15f4"
    upstreamHairShaderPath: "packages/engine/src/rendering/webgpu/shaders/skin-skinning.wgsl"
